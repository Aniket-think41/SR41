# ============================================================
# SkillShare API — environment configuration
# Copy to .env and fill in. Every value has a dev-safe default
# (see app/config.py); the ones marked REQUIRED matter in prod.
# ============================================================

# --- Core -----------------------------------------------------
ENV=development                                   # development | production
# REQUIRED in prod. Postgres 15+; SQLite default is for local dev only.
DATABASE_URL=postgresql+psycopg2://skillshare:skillshare@localhost:5432/skillshare
# DATABASE_URL=sqlite:///./skillshare.db          # local-dev default

# --- JWT (BACKEND_SPEC §4.1) ----------------------------------
# REQUIRED in prod: long random string when using HS256.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256                               # HS256 (default) or RS256
# For RS256, provide the PEM keypair instead of JWT_SECRET:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days
REFRESH_TOKEN_EXPIRE_DAYS=15

# --- Google OAuth (POST /api/auth/google) ---------------------
# Optional — endpoint returns 403 until set.
GOOGLE_CLIENT_ID=

# --- CORS ------------------------------------------------------
# The dashboard origin(s), comma-separated. REQUIRED in prod.
CORS_ORIGINS=http://localhost:3001

# --- Rate limiting (BACKEND_SPEC §4.3) -------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_SEARCH_PER_MIN=30
# Optional: shared store for multi-instance deployments (in-memory otherwise)
REDIS_URL=

# --- AWS SES SMTP (org invitation emails) ----------------------
# Best-effort: if disabled, invitations are still created in the DB.
# Uses SES SMTP credentials (separate from IAM keys — generate them in
# the AWS SES console under SMTP Settings → Create SMTP Credentials).
SES_ENABLED=false                               # set true in prod
SES_SENDER=                                     # verified SES identity, e.g. noreply@skillshare.think41.com
SES_SMTP_USERNAME=                              # SES SMTP username (AKIA…)
SES_SMTP_PASSWORD=                              # SES SMTP password
SES_SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SES_SMTP_PORT=587

# --- File uploads / storage (BACKEND_SPEC §6) ------------------
# Switchable backend for uploaded images / video / diagrams / files.
# local for dev; gcs is the default cloud provider, s3 the alternative.
STORAGE_BACKEND=local                             # local | gcs | s3
# -- local backend (dev): files written to disk + served from /uploads
UPLOAD_DIR=var/uploads
PUBLIC_BASE_URL=http://localhost:8400             # base for /uploads/<key> URLs (this API's public origin)
# -- gcs backend (prod, default cloud): set STORAGE_BACKEND=gcs and fill these (Google Cloud Storage)
GCS_BUCKET=
GCS_PROJECT=                                      # optional; inferred from credentials when empty
GCS_CREDENTIALS_FILE=                             # path to a service-account JSON; empty → Application Default Credentials
GCS_PUBLIC_BASE_URL=                              # empty → https://storage.googleapis.com/<bucket>; or a CDN base
# -- s3 backend (alternative): set STORAGE_BACKEND=s3 and fill these (AWS S3 / R2 / MinIO)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=                                  # e.g. https://<account>.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=                               # e.g. https://cdn.skillshare.think41.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=50                                  # images/diagrams/short clips; raise for video

# --- Licensing (BACKEND_SPEC §3.7) -----------------------------
LICENSE_KEY_PATTERN=^T41-PREM-[A-Z0-9]{4,}$

# --- Integrations: at-rest credential encryption (app/crypto.py) ---
# url-safe base64 Fernet key for encrypting stored integration tokens (GitHub).
# Empty → a stable key is derived from JWT_SECRET (fine for dev). In prod set an
# explicit key so rotating JWT_SECRET doesn't strand encrypted credentials:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_KEY=

# Public origin of THIS backend (for GitHub OAuth callback + webhook URLs).
INTEGRATION_BASE_URL=https://skillshare-backend-1081098542602.us-central1.run.app

# --- GitHub App (multi-org install; inert until set) ---
# Register a GitHub App → Contents R/W + Metadata R + Administration R (hooks);
# Callback URL = <INTEGRATION_BASE_URL>/api/integrations/github/oauth/callback;
# Setup URL (same); Webhook URL = <INTEGRATION_BASE_URL>/api/integrations/github/webhook.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- GitHub OAuth App (alternative connect; inert until set) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub webhooks (live sync). Empty → webhook endpoint returns disabled. ---
GITHUB_WEBHOOK_SECRET=

# --- AI metadata generation (Anthropic; app/ai.py). Empty → skipped. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Scheduled sync: shared secret for POST /api/cron/integrations/sync ---
CRON_SECRET=

# --- Seed script (scripts/seed.py) -----------------------------
SEED_PASSWORD=skillshare-demo
