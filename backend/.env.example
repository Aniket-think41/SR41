# ============================================================
# SkillShare API — environment configuration
# Copy to .env and fill in. Every value has a dev-safe default
# (see app/config.py); the ones marked REQUIRED matter in prod.
# ============================================================

# --- Core -----------------------------------------------------
ENV=development                                   # development | production
# REQUIRED in prod. Postgres 15+; SQLite default is for local dev only.
DATABASE_URL=postgresql+psycopg2://skillshare:skillshare@localhost:5432/skillshare
# DATABASE_URL=sqlite:///./skillshare.db          # local-dev default

# --- JWT (BACKEND_SPEC §4.1) ----------------------------------
# REQUIRED in prod: long random string when using HS256.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256                               # HS256 (default) or RS256
# For RS256, provide the PEM keypair instead of JWT_SECRET:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth (POST /api/auth/google) ---------------------
# Optional — endpoint returns 403 until set.
GOOGLE_CLIENT_ID=

# --- CORS ------------------------------------------------------
# The dashboard origin(s), comma-separated. REQUIRED in prod.
CORS_ORIGINS=http://localhost:3001

# --- Rate limiting (BACKEND_SPEC §4.3) -------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_SEARCH_PER_MIN=30
# Optional: shared store for multi-instance deployments (in-memory otherwise)
REDIS_URL=

# --- File uploads / S3 (BACKEND_SPEC §6) -----------------------
# Optional — uploads return a placeholder URL until configured.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=                                  # e.g. https://<account>.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=                               # e.g. https://cdn.skillshare.think41.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10

# --- Licensing (BACKEND_SPEC §3.7) -----------------------------
LICENSE_KEY_PATTERN=^T41-PREM-[A-Z0-9]{4,}$

# --- Seed script (scripts/seed.py) -----------------------------
SEED_PASSWORD=skillshare-demo
